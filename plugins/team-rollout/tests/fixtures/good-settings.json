{
  "permissions": {
    "defaultMode": "default",
    "allow": [
      "Read",
      "Glob",
      "Grep",
      "Bash(npm test:*)",
      "Bash(git diff:*)"
    ],
    "deny": [
      "Read(**/.env)",
      "Write(**/.aws/**)"
    ]
  },
  "strictKnownMarketplaces": [
    {
      "source": "github",
      "repo": "example-org/marketplace",
      "ref": "v1.2.0"
    }
  ],
  "model": "claude-sonnet-5",
  "env": {
    "DISABLE_TELEMETRY": "1"
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/scripts/gate.sh",
            "timeout": 300
          }
        ]
      }
    ]
  },
  "extraKnownMarketplaces": {
    "example": {
      "source": {
        "source": "github",
        "repo": "example-org/marketplace",
        "ref": "v1.2.0"
      }
    }
  }
}
